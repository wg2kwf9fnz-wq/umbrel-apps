#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DATA_ROOT:-${APP_DIR}/data}"

# Create the persistent bind-mount directory for both fresh installs and
# existing installs receiving this update. The image's app user is UID/GID 100.
mkdir -p "$DATA_DIR"
chown 100:100 "$DATA_DIR"
